{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quest Log",
  "version": "0.1.0",
  "identifier": "io.github.edscaylart.questlog",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quest Log",
        "width": 420,
        "height": 720,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFQUQzMjMxOUIyOEUyNTAKUldSUTRpaWJNVEt0dmdIMHlsZmptWk0ySlNIc2VieUtLWDAwZGo3Rmljb0FKeUdrTitBeFBPMGoK",
      "endpoints": ["https://github.com/edscaylart/quest-log/releases/latest/download/latest.json"]
    }
  }
}
